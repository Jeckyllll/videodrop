VIDEODROP_OWNER_ID=
VIDEODROP_BOT_TOKEN=
# Empty: Telegram-only mode; no public HTTP API or downloads.
VIDEODROP_PUBLIC_URL=
# files: only 24-hour download links; all: also pairing, extension API and OAuth.
VIDEODROP_PUBLIC_MODE=files
VIDEODROP_STORAGE_GIB=20
VIDEODROP_JOB_GIB=8
# A local official Telegram Bot API server can raise the file limit to 2000 MB.
VIDEODROP_TELEGRAM_URL=https://api.telegram.org
VIDEODROP_TELEGRAM_LOCAL=0
