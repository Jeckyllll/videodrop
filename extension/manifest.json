{
  "manifest_version": 3,
  "name": "VideoDrop — видео на Mac",
  "version": "1.5.2",
  "description": "Передать видео с открытой страницы в локальное приложение VideoDrop.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webRequest",
    "debugger",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Скачать через VideoDrop"
  },
  "minimum_chrome_version": "120",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*"
    ]
  }
}
